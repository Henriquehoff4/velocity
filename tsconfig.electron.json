{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "node20",
    "moduleResolution": "node16",
    "rootDir": "src",
    "outDir": "dist-electron",
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/main", "src/shared"]
}
